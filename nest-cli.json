{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/bookstore-api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api-gateway",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "gstreamer": {
      "type": "application",
      "root": "apps/gstreamer",
      "entryFile": "main",
      "sourceRoot": "apps/gstreamer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gstreamer/tsconfig.app.json"
      }
    },
    "recording": {
      "type": "application",
      "root": "apps/recording",
      "entryFile": "main",
      "sourceRoot": "apps/recording/src",
      "compilerOptions": {
        "tsConfigPath": "apps/recording/tsconfig.app.json"
      }
    },
    "rtsp": {
      "type": "application",
      "root": "apps/rtsp",
      "entryFile": "main",
      "sourceRoot": "apps/rtsp/src",
      "compilerOptions": {
        "tsConfigPath": "apps/rtsp/tsconfig.app.json"
      }
    },
    "go2rtc": {
      "type": "application",
      "root": "apps/go2rtc",
      "entryFile": "main",
      "sourceRoot": "apps/go2rtc/src",
      "compilerOptions": {
        "tsConfigPath": "apps/go2rtc/tsconfig.app.json"
      }
    }
  }
}